# ===================================================================
#  ナラ枯れビューアー / .gitignore
#
#  方針：再生成できるものは入れない。
#        コードと文書だけを版管理し、リポジトリを軽く保つ。
# ===================================================================

# --- オルソのタイル（105MB / 6,700ファイル）----------------------
#  元のオルソから tools/ingest_ortho.py で再生成できる
data/tiles/

# --- 国土地理院タイルの控え（30MB / 1,700ファイル）--------------
#  tools/fetch_basemap.py で再取得できる。
#  国土地理院タイルの再配布にあたらないよう、リポジトリには入れない
data/basemap/
data/dem_cache/

# --- 北海道オープンデータの元zipと展開物（27MB）-----------------
#  tools/build_forest.py が自動で取得する
data/_src/

# --- オープンデータから作った参照データ（再生成可）---------------
#  初期設定（最初に一度だけ）.bat  または tools/build_forest.py で作り直せる
data/forest.db
data/forest.db-wal
data/forest.db-shm
data/layers/

# --- 現地写真（バックアップは Git ではなく バックアップ.bat で）---
#  写真は数が増えるとリポジトリが実用に耐えなくなる。
#  被害木の現場写真には人や車が写り込むこともあるので、
#  公開の経路に載せない方が安全でもある。
#  data/survey.db だけは Git に入れている（被害木の記録そのもので、
#  リポジトリは Private。ただしこれもバックアップ.bat の対象）。
data/photos/

# --- 控えの置き場 ------------------------------------------------
バックアップ/

# --- 役場に渡すZIP（納品セットを作る.bat が作る）-----------------
#  中身はすべてこのリポジトリから作り直せる
納品/

# --- 取り込みの一時ファイル --------------------------------------
data/_import.log
data/sites.json
オルソ投入/*
!オルソ投入/ここにオルソを入れてください.txt

# --- SQLite の作業ファイル ---------------------------------------
*.db-wal
*.db-shm

# --- Python ------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/

# --- OS / エディタ -----------------------------------------------
Thumbs.db
desktop.ini
.DS_Store
.vscode/
.idea/
*.swp

# 外に出すときの合言葉（絶対にコミットしない）
data/.secret

# トンネルの実行ファイル（55MB。各自で入れる）
bin/
